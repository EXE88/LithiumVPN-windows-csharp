<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Lithiumvpn.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lithiumvpn">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Global dialog acrylic — TintColor uses SystemChromeLowColor which is dark in dark mode, light in light mode -->
            <AcrylicBrush x:Key="DialogAcrylic"
                          TintColor="{ThemeResource SystemChromeLowColor}"
                          TintOpacity="0.6"
                          FallbackColor="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///DevWinUI.Controls/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
