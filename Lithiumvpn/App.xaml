<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Lithiumvpn.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lithiumvpn">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Global dialog acrylic used by ContentDialogs to provide consistent blurred background -->
            <AcrylicBrush x:Key="DialogAcrylic"
                          TintColor="{ThemeResource SystemBaseHighColor}"
                          TintOpacity="0.1"
                          FallbackColor="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///DevWinUI.Controls/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
