<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lithiumvpn.Pages.CoinsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Lithiumvpn"
    xmlns:dev="using:DevWinUI"
    mc:Ignorable="d">

    <Grid>
        <TextBlock Text="Coins"
                   FontSize="24" FontWeight="Bold"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <TeachingTip x:Name="TourTip1"
                     Title="Coins Page"
                     Subtitle="Check your coin balance here. You can earn coins by referring friends and use them to purchase plans."
                     CloseButtonContent="Got it ✓"
                     IsOpen="False"/>
    </Grid>
</Page>
