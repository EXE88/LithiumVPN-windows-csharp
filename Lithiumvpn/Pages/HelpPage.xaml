<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lithiumvpn.Pages.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Padding="20,15">

            <TextBlock Text="Help &amp; Tour Guide"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Select a section to start an interactive tour."
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,8"/>

            <!-- Dashboard -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="15,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE80F;" FontSize="22"
                              Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                              VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Dashboard" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Connect to VPN, view stats and manage your active config."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Start Tour" Tag="Dashboard"
                            Click="StartTour_Click" VerticalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Configs -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="15,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE838;" FontSize="22"
                              Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                              VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Configs" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Browse and select VPN server configurations."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Start Tour" Tag="Configs"
                            Click="StartTour_Click" VerticalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Account -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="15,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="22"
                              Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                              VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Account" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="View and manage your account details and subscription."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Start Tour" Tag="Account"
                            Click="StartTour_Click" VerticalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Coins -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="15,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE8C7;" FontSize="22"
                              Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                              VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Coins" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Check your coin balance and earn more through referrals."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Start Tour" Tag="Coins"
                            Click="StartTour_Click" VerticalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Plans -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="15,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE787;" FontSize="22"
                              Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                              VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Plans" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Explore and purchase subscription plans."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Start Tour" Tag="Plans"
                            Click="StartTour_Click" VerticalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
