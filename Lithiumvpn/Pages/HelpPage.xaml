<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lithiumvpn.Pages.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid FlowDirection="{Binding FlowDirection, Source={StaticResource Loc}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Padding="20,15">

            <TextBlock Text="{Binding [Help_Title], Source={StaticResource Loc}}"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="{Binding [Help_Subtitle], Source={StaticResource Loc}}"
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,8"/>

            <!-- Dashboard -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="15,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE80F;" FontSize="22"
                              Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                              VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Nav_Dashboard], Source={StaticResource Loc}}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding [Help_DashboardDesc], Source={StaticResource Loc}}"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="{Binding [Help_StartTour], Source={StaticResource Loc}}" Tag="Dashboard"
                            Click="StartTour_Click" VerticalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Configs -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="15,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE838;" FontSize="22"
                              Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                              VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Nav_Configs], Source={StaticResource Loc}}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding [Help_ConfigsDesc], Source={StaticResource Loc}}"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="{Binding [Help_StartTour], Source={StaticResource Loc}}" Tag="Configs"
                            Click="StartTour_Click" VerticalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Account -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="15,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="22"
                              Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                              VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Nav_Account], Source={StaticResource Loc}}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding [Help_AccountDesc], Source={StaticResource Loc}}"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="{Binding [Help_StartTour], Source={StaticResource Loc}}" Tag="Account"
                            Click="StartTour_Click" VerticalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Coins -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="15,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE8C7;" FontSize="22"
                              Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                              VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Nav_Coins], Source={StaticResource Loc}}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding [Help_CoinsDesc], Source={StaticResource Loc}}"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="{Binding [Help_StartTour], Source={StaticResource Loc}}" Tag="Coins"
                            Click="StartTour_Click" VerticalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Plans -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="15,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE787;" FontSize="22"
                              Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                              VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Nav_Plans], Source={StaticResource Loc}}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding [Help_PlansDesc], Source={StaticResource Loc}}"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="{Binding [Help_StartTour], Source={StaticResource Loc}}" Tag="Plans"
                            Click="StartTour_Click" VerticalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- ════════ Support / Tickets ════════ -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Help_SupportTitle], Source={StaticResource Loc}}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{Binding [Help_SupportSubtitle], Source={StaticResource Loc}}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Click="NewTicket_Click"
                        Style="{ThemeResource AccentButtonStyle}"
                        CornerRadius="9" Padding="12,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="White"/>
                        <TextBlock Text="{Binding [Help_NewTicket], Source={StaticResource Loc}}" FontSize="13" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel x:Name="TicketsList" Spacing="8"/>

            <StackPanel x:Name="TicketsEmpty" Spacing="8"
                        HorizontalAlignment="Center" Margin="0,24,0,0"
                        Visibility="Collapsed">
                <FontIcon Glyph="&#xE8BD;" FontSize="34"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding [Help_NoTickets], Source={StaticResource Loc}}"
                           FontSize="13" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

    <!-- ════════ Chat overlay ════════ -->
    <Grid x:Name="ChatOverlay" Visibility="Collapsed"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="14,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="ChatBack_Click"
                        Background="Transparent" BorderThickness="0"
                        Padding="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72B;" FontSize="16"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ChatSubject" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="ChatMeta" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Messages -->
        <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel x:Name="MessagesList" Spacing="8"/>
        </ScrollViewer>

        <!-- Input -->
        <Border Grid.Row="2" Padding="12,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MessageInput" Grid.Column="0"
                         PlaceholderText="{Binding [Help_TypeMessage], Source={StaticResource Loc}}"
                         CornerRadius="10" AcceptsReturn="False"
                         MaxLength="1000" VerticalAlignment="Center"/>
                <Button x:Name="SendButton" Grid.Column="1" Click="SendMessage_Click"
                        Style="{ThemeResource AccentButtonStyle}"
                        CornerRadius="10" Padding="12,9" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE724;" FontSize="15" Foreground="White"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
  </Grid>
</Page>
