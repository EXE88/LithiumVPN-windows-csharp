<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lithiumvpn.Pages.PlansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Lithiumvpn"
    xmlns:controls="using:Lithiumvpn.Controls"
    xmlns:dev="using:DevWinUI"
    mc:Ignorable="d">

    <Page.Resources>

        <!-- ظاهر پایه‌ی plan card -->
        <Style x:Key="PlanCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <!-- یک ردیف ویژگی (آیکن + متن) -->
        <Style x:Key="FeatureIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{ThemeResource AccentAAFillColorDefaultBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FeatureTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Style>
    </Page.Resources>

    <Grid FlowDirection="{Binding FlowDirection, Source={StaticResource Loc}}">
    <ScrollViewer x:Name="ContentScroll" Padding="16,15,16,15" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="28"/>
                    <RepositionThemeTransition/>
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <!-- ════════ موجودی Coins ════════ -->
            <Border x:Name="BalanceCard"
                    Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                    CornerRadius="16" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                            Background="#33FFFFFF" Margin="0,0,12,0">
                        <FontIcon Glyph="&#xE8C7;" FontSize="20" Foreground="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding [Plans_YourBalance], Source={StaticResource Loc}}" FontSize="11" Foreground="#CCFFFFFF"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="HeroBalanceText" Text="0"
                                       FontSize="26" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding [Plans_Coins], Source={StaticResource Loc}}" FontSize="13" Foreground="#CCFFFFFF"
                                       VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════════ Section header ════════ -->
            <TextBlock Text="{Binding [Plans_ChooseAPlan], Source={StaticResource Loc}}"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="2,6,0,0"/>

            <!-- Plan cards are generated at runtime from the /plans/ endpoint -->
            <StackPanel x:Name="PlansContainer" Spacing="12"/>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" Spacing="10"
                        HorizontalAlignment="Center" Margin="0,40,0,0"
                        Visibility="Collapsed">
                <FontIcon Glyph="&#xE7BA;" FontSize="40"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding [Plans_Empty], Source={StaticResource Loc}}"
                           FontSize="13" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- ════════ تور راهنما ════════ -->
            <TeachingTip x:Name="TourTip1"
                         Target="{x:Bind BalanceCard}"
                         Title="{Binding [Plans_Tour1Title], Source={StaticResource Loc}}"
                         Subtitle="{Binding [Plans_Tour1Sub], Source={StaticResource Loc}}"
                         ActionButtonContent="{Binding [Common_Next], Source={StaticResource Loc}}"
                         CloseButtonContent="{Binding [Common_SkipTour], Source={StaticResource Loc}}"
                         IsOpen="False"/>

            <TeachingTip x:Name="TourTip2"
                         Title="{Binding [Plans_Tour2Title], Source={StaticResource Loc}}"
                         Subtitle="{Binding [Plans_Tour2Sub], Source={StaticResource Loc}}"
                         ActionButtonContent="{Binding [Common_Next], Source={StaticResource Loc}}"
                         CloseButtonContent="{Binding [Common_SkipTour], Source={StaticResource Loc}}"
                         IsOpen="False"/>

            <TeachingTip x:Name="TourTip3"
                         Title="{Binding [Plans_Tour3Title], Source={StaticResource Loc}}"
                         Subtitle="{Binding [Plans_Tour3Sub], Source={StaticResource Loc}}"
                         CloseButtonContent="{Binding [Common_Done], Source={StaticResource Loc}}"
                         IsOpen="False"/>

        </StackPanel>
    </ScrollViewer>

    <controls:OfflineNotice x:Name="OfflinePanel" Visibility="Collapsed"/>
    </Grid>
</Page>
