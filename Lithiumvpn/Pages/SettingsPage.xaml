<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lithiumvpn.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lithiumvpn"
    xmlns:dev="using:DevWinUI">

    <ScrollViewer Padding="20,15,20,15">
        <StackPanel Spacing="10" MaxWidth="520" HorizontalAlignment="Left">

            <TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,8"/>

            <!-- Theme -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16,14">
                <!-- Use two-row layout: title+control on first row, description on second row to avoid overlap -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title (left) -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="App Theme"
                               Padding="0,6,80,0"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               FontWeight="SemiBold" FontSize="14"/>

                    <!-- Control (right) -->
                    <ComboBox Grid.Row="0" Grid.Column="1" MinWidth="150"
                              VerticalAlignment="Center"
                              dev:ThemeServiceAttach.ThemeService="{x:Bind local:App.GetThemeService}">
                        <ComboBoxItem Content="Light"  Tag="Light"/>
                        <ComboBoxItem Content="Dark"   Tag="Dark"/>
                        <ComboBoxItem Content="System" Tag="Default"/>
                    </ComboBox>

                    <!-- Description (full width, below) -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="Choose your preferred color theme"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- Window Effect / Backdrop -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Window Effect"
                               Padding="0,6,80,0"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               FontWeight="SemiBold" FontSize="14"/>

                    <ComboBox Grid.Row="0" Grid.Column="1" MinWidth="150"
                              VerticalAlignment="Center"
                              dev:ThemeServiceAttach.ThemeService="{x:Bind local:App.GetThemeService}">
                        <ComboBoxItem Content="Matte"      Tag="Mica"/>
                        <ComboBoxItem Content="High Matte" Tag="MicaAlt"/>
                        <ComboBoxItem Content="Glass"      Tag="Acrylic"/>
                        <ComboBoxItem Content="Glass Thin" Tag="AcrylicThin"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="Choose the window background effect"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
