<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lithiumvpn.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lithiumvpn"
    xmlns:dev="using:DevWinUI"
    FlowDirection="{Binding FlowDirection, Source={StaticResource Loc}}">

    <ScrollViewer Padding="20,15,20,15">
        <StackPanel Spacing="10" MaxWidth="520" HorizontalAlignment="Left">

            <TextBlock Text="{Binding [Settings_Appearance], Source={StaticResource Loc}}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,8"/>

            <!-- Theme -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16,14">
                <!-- Use two-row layout: title+control on first row, description on second row to avoid overlap -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title (left) -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Settings_AppTheme], Source={StaticResource Loc}}"
                               Padding="0,6,80,0"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               FontWeight="SemiBold" FontSize="14"/>

                    <!-- Control (right) -->
                    <ComboBox Grid.Row="0" Grid.Column="1" MinWidth="150"
                              VerticalAlignment="Center"
                              dev:ThemeServiceAttach.ThemeService="{x:Bind local:App.GetThemeService}">
                        <ComboBoxItem Content="{Binding [Settings_ThemeLight], Source={StaticResource Loc}}"  Tag="Light"/>
                        <ComboBoxItem Content="{Binding [Settings_ThemeDark], Source={StaticResource Loc}}"   Tag="Dark"/>
                        <ComboBoxItem Content="{Binding [Settings_ThemeSystem], Source={StaticResource Loc}}" Tag="Default"/>
                    </ComboBox>

                    <!-- Description (full width, below) -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding [Settings_ThemeDesc], Source={StaticResource Loc}}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- Window Effect / Backdrop -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Settings_WindowEffect], Source={StaticResource Loc}}"
                               Padding="0,6,80,0"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               FontWeight="SemiBold" FontSize="14"/>

                    <ComboBox Grid.Row="0" Grid.Column="1" MinWidth="150"
                              VerticalAlignment="Center"
                              dev:ThemeServiceAttach.ThemeService="{x:Bind local:App.GetThemeService}">
                        <ComboBoxItem Content="{Binding [Settings_EffectMatte], Source={StaticResource Loc}}"      Tag="Mica"/>
                        <ComboBoxItem Content="{Binding [Settings_EffectHighMatte], Source={StaticResource Loc}}" Tag="MicaAlt"/>
                        <ComboBoxItem Content="{Binding [Settings_EffectGlass], Source={StaticResource Loc}}"      Tag="Acrylic"/>
                        <ComboBoxItem Content="{Binding [Settings_EffectGlassThin], Source={StaticResource Loc}}" Tag="AcrylicThin"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding [Settings_WindowEffectDesc], Source={StaticResource Loc}}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- ── Language & Region ── -->
            <TextBlock Text="{Binding [Settings_LanguageSection], Source={StaticResource Loc}}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       Margin="0,12,0,8"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Settings_Language], Source={StaticResource Loc}}"
                               Padding="0,6,80,0"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               FontWeight="SemiBold" FontSize="14"/>

                    <ComboBox x:Name="LanguageComboBox" Grid.Row="0" Grid.Column="1" MinWidth="150"
                              VerticalAlignment="Center"
                              SelectionChanged="LanguageComboBox_SelectionChanged">
                        <ComboBoxItem Content="{Binding [Settings_LanguageEnglish], Source={StaticResource Loc}}" Tag="en"/>
                        <ComboBoxItem Content="{Binding [Settings_LanguagePersian], Source={StaticResource Loc}}" Tag="fa"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding [Settings_LanguageDesc], Source={StaticResource Loc}}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- ── Proxy Exceptions ── -->
            <TextBlock Text="{Binding [Settings_ProxySection], Source={StaticResource Loc}}"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       Margin="0,12,0,8"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16,14">
                <StackPanel Spacing="10">

                    <TextBlock Text="{Binding [Settings_ProxyExceptions], Source={StaticResource Loc}}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding [Settings_ProxyExceptionsDesc], Source={StaticResource Loc}}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap"/>

                    <!-- Add row -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ProxyEntryBox" Grid.Column="0"
                                 PlaceholderText="{Binding [Settings_ProxyAddPlaceholder], Source={StaticResource Loc}}"
                                 KeyDown="ProxyEntryBox_KeyDown"/>
                        <Button x:Name="ProxyAddButton" Grid.Column="1"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="{Binding [Settings_ProxyAdd], Source={StaticResource Loc}}"
                                Click="ProxyAdd_Click"/>
                    </Grid>

                    <InfoBar x:Name="ProxyInfoBar" IsOpen="False" Severity="Warning" IsClosable="True"/>

                    <!-- Entries -->
                    <TextBlock x:Name="ProxyEmptyText"
                               Text="{Binding [Settings_ProxyEmpty], Source={StaticResource Loc}}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               FontSize="12" Visibility="Collapsed"/>
                    <ItemsControl x:Name="ProxyList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
