<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lithiumvpn.Pages.SplashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <!-- پس‌زمینه تیره با کمی شفافیت -->
        <Rectangle Fill="{ThemeResource LayerFillColorDefaultBrush}" Opacity="0.6"/>

        <!-- محتوای مرکزی -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="24">

            <!-- لوگو -->
            <Image x:Name="SplashLogo"
                   Width="120" Height="60"
                   Stretch="Uniform"
                   HorizontalAlignment="Center">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" ScaleX="0.8" ScaleY="0.8"/>
                </Image.RenderTransform>
                <Image.RenderTransformOrigin>0.5,0.5</Image.RenderTransformOrigin>
            </Image>

            <!-- Morphing Text -->
            <TextBlock x:Name="MorphText"
                       Text="LithiumVPN"
                       FontSize="28"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       Opacity="0">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="MorphTranslate" Y="10"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- Progress Bar -->
            <ProgressBar x:Name="LoadingBar"
                         IsIndeterminate="True"
                         Width="200"
                         Height="3"
                         Opacity="0"
                         CornerRadius="2"
                         Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
        </StackPanel>
    </Grid>
</Page>
