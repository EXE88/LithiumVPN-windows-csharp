<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lithiumvpn.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dev="using:DevWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    >

    <Grid x:Name="RootGrid">
        <dev:Particle IsPointerEnable="False"
                      Density="4" ParticleColor="White" LineColor="White"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      IsHitTestVisible="False" Opacity="0.15"/>

        <!-- ══ LOGIN CARD ══ -->
        <Border x:Name="LoginCard"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="16"
                Width="400" VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="32,28">
            <Border.RenderTransform>
                <TranslateTransform x:Name="LoginCardTranslate" X="0"/>
            </Border.RenderTransform>

            <StackPanel Spacing="14">
                <Image x:Name="AppLogoLogin" Width="48" Height="48"
                       HorizontalAlignment="Center" Margin="0,4,0,4"/>

                <TextBlock Text="Welcome Back" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Sign in to your Lithium account"
                           FontSize="12" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="LoginUsername" Header="Username"
                         PlaceholderText="Enter username" CornerRadius="10"/>
                <PasswordBox x:Name="LoginPassword" Header="Password"
                             PlaceholderText="Enter password" CornerRadius="10"/>

                <TextBlock x:Name="LoginError" Foreground="#FFE53935" FontSize="12"
                           HorizontalAlignment="Center" Visibility="Collapsed"/>

                <Button Content="Sign In" HorizontalAlignment="Stretch"
                        CornerRadius="10" Height="42" Margin="0,4,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="LoginBtn_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Spacing="4" Margin="0,4,0,0">
                    <TextBlock Text="Don't have an account?" FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <HyperlinkButton Content="Create one" FontSize="12" Padding="4,0"
                                     Click="SwitchToRegister_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══ REGISTER CARD ══ -->
        <Border x:Name="RegisterCard"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="16"
                Width="400" VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="32,24" Opacity="0" Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="RegisterCardTranslate" X="40"/>
            </Border.RenderTransform>

            <StackPanel Spacing="12">

                <!-- Header + Back -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Background="Transparent" BorderThickness="0"
                            Padding="4,4" VerticalAlignment="Center"
                            Click="SwitchToLogin_Click">
                        <FontIcon Glyph="&#xE72B;" FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>
                    <TextBlock Grid.Column="1" Text="Create Account"
                               FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,0,28,0"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </Grid>

                <!-- StepBar -->
                <dev:StepBar x:Name="RegisterStepBar" StepIndex="0" Margin="0,4,0,8" Background="Transparent" BorderThickness="0">
                    <dev:StepBarItem Content="Info"/>
                    <dev:StepBarItem Content="Verify"/>
                    <dev:StepBarItem Content="Done"/>
                </dev:StepBar>

                <!-- ── Step 1: Info ── -->
                <StackPanel x:Name="Step1Panel" Spacing="10">
                    <TextBox x:Name="RegUsername" Header="Username"
                             PlaceholderText="Choose a username" CornerRadius="10"/>
                    <TextBox x:Name="RegEmail" Header="Email"
                             PlaceholderText="your@email.com" CornerRadius="10"/>
                    <PasswordBox x:Name="RegPassword" Header="Password"
                                 PlaceholderText="Create a strong password" CornerRadius="10"/>
                    <PasswordBox x:Name="RegConfirmPassword" Header="Confirm Password"
                                 PlaceholderText="Repeat your password" CornerRadius="10"/>
                    <TextBlock x:Name="Step1Error" Foreground="#FFE53935" FontSize="12"
                               HorizontalAlignment="Center" Visibility="Collapsed"/>
                    <Button Content="Continue →" HorizontalAlignment="Stretch"
                            CornerRadius="10" Height="42" Margin="0,4,0,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="RegNext_Click"/>
                </StackPanel>

                <!-- ── Step 2: OTP ── -->
                <StackPanel x:Name="Step2Panel" Spacing="14"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE715;" FontSize="36"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Check your email" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="OtpEmailHint" FontSize="12" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="280" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <!-- PinBox از DevWinUI.Controls — اگر Count کار نکرد PinLength امتحان کن -->
                    <dev:PinBox x:Name="OtpPinBox" PasswordLength="6"
                                HorizontalAlignment="Center" Margin="0,8,0,8"/>

                    <TextBlock x:Name="Step2Error" Foreground="#FFE53935" FontSize="12"
                               HorizontalAlignment="Center" Visibility="Collapsed"/>
                    <Button Content="Verify Code" HorizontalAlignment="Stretch"
                            CornerRadius="10" Height="42"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="RegVerify_Click"/>
                </StackPanel>

                <!-- ── Step 3: Welcome ── -->
                <Grid x:Name="Step3Panel" Visibility="Collapsed" MinHeight="240" Padding="20" HorizontalAlignment="Stretch">
                    <dev:ConfettiCannon x:Name="ConfettiLeft"/>
                    <dev:ConfettiCannon x:Name="ConfettiRight"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="10" Margin="0" 
						        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
						        Padding="30" Width="300" Height="300">
                        <PersonPicture x:Name="WelcomeAvatar" Width="80" Height="80"
                                       HorizontalAlignment="Center"/>
                        <TextBlock x:Name="WelcomeTitle" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Your account has been created successfully!"
                                   FontSize="12" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="320"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ProgressBar IsIndeterminate="True" Width="100" Height="2"
                                     CornerRadius="1" Margin="0,10,0,2"/>
                        <TextBlock x:Name="CountdownText" FontSize="11"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
