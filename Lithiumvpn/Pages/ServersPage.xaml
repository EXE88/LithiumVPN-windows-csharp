<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lithiumvpn.Pages.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lithiumvpn"
    xmlns:controls="using:Lithiumvpn.Controls"
    xmlns:dev="using:DevWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="PurchaseTagStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AccentAAFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="ConfigCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style x:Key="InfoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid FlowDirection="{Binding FlowDirection, Source={StaticResource Loc}}">
    <ScrollViewer x:Name="ContentScroll" Padding="16,15,16,15" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="28"/>
                    <RepositionThemeTransition/>
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <!-- Import feedback -->
            <InfoBar x:Name="ImportInfoBar" IsOpen="False" IsClosable="True"/>

            <!-- ════════ Imported / personal configs ════════ -->
            <StackPanel x:Name="ImportedSection" Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Configs_ImportedTitle], Source={StaticResource Loc}}"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding [Configs_ImportedSubtitle], Source={StaticResource Loc}}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="AddConfigButton" Grid.Column="1" Click="AddConfig_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            CornerRadius="9" Padding="12,7" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="White"/>
                            <TextBlock Text="{Binding [Configs_AddFromClipboard], Source={StaticResource Loc}}"
                                       FontSize="13" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Expander x:Name="ImportedExpander" IsExpanded="True"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1" CornerRadius="12">
                    <Expander.Resources>
                        <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="CardBackgroundFillColorDefaultBrush"/>
                        <StaticResource x:Key="ExpanderContentBackground" ResourceKey="CardBackgroundFillColorDefaultBrush"/>
                    </Expander.Resources>
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,8,0,8">
                            <FontIcon Glyph="&#xE77B;" FontSize="16"
                                      Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock x:Name="ImportedExpanderHeader"
                                       FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel x:Name="ImportedContainer" Spacing="8" Padding="0,4,0,4"/>
                </Expander>

                <TextBlock x:Name="ImportedEmpty"
                           Text="{Binding [Configs_ImportEmpty], Source={StaticResource Loc}}"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Margin="2,2,0,6" Visibility="Collapsed"/>
            </StackPanel>

            <!-- ════════ Purchased (backend) configs ════════ -->
            <TextBlock x:Name="BackendHeader"
                       Text="{Binding [Configs_BackendTitle], Source={StaticResource Loc}}"
                       FontSize="15" FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       Margin="0,4,0,0"/>

            <!-- ════════ Summary card ════════ -->
            <Border x:Name="HeroCard"
                    Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                    CornerRadius="16" Padding="20,16">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="11" Background="#33FFFFFF">
                            <FontIcon Glyph="&#xE838;" FontSize="18" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding [Servers_Subscriptions], Source={StaticResource Loc}}"
                                   FontSize="19" FontWeight="Bold" Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="StatActive" Text="0" FontSize="24" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding [Servers_Active], Source={StaticResource Loc}}" FontSize="11" Foreground="#CCFFFFFF"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Rectangle Grid.Column="1" Width="1" Fill="#40FFFFFF" Margin="0,4"/>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="StatLocations" Text="0" FontSize="24" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding [Servers_Locations], Source={StaticResource Loc}}" FontSize="11" Foreground="#CCFFFFFF"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Rectangle Grid.Column="3" Width="1" Fill="#40FFFFFF" Margin="0,4"/>
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="StatPurchases" Text="0" FontSize="24" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding [Servers_Purchases], Source={StaticResource Loc}}" FontSize="11" Foreground="#CCFFFFFF"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Purchases (expanders + config cards) are generated at runtime from /accounts/status/ -->
            <StackPanel x:Name="PurchasesContainer" Spacing="12"/>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" Spacing="10"
                        HorizontalAlignment="Center" Margin="0,40,0,0"
                        Visibility="Collapsed">
                <FontIcon Glyph="&#xE838;" FontSize="40"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding [Servers_Empty], Source={StaticResource Loc}}"
                           FontSize="13" HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- ════════ تور راهنما ════════ -->
            <TeachingTip x:Name="TourTip1"
                         Target="{x:Bind HeroCard}"
                         Title="{Binding [Servers_Tour1Title], Source={StaticResource Loc}}"
                         Subtitle="{Binding [Servers_Tour1Sub], Source={StaticResource Loc}}"
                         ActionButtonContent="{Binding [Common_Next], Source={StaticResource Loc}}"
                         CloseButtonContent="{Binding [Common_SkipTour], Source={StaticResource Loc}}"
                         IsOpen="False"/>

            <TeachingTip x:Name="TourTip2"
                         Title="{Binding [Servers_Tour2Title], Source={StaticResource Loc}}"
                         Subtitle="{Binding [Servers_Tour2Sub], Source={StaticResource Loc}}"
                         ActionButtonContent="{Binding [Common_Next], Source={StaticResource Loc}}"
                         CloseButtonContent="{Binding [Common_SkipTour], Source={StaticResource Loc}}"
                         IsOpen="False"/>

            <TeachingTip x:Name="TourTip3"
                         Title="{Binding [Servers_Tour3Title], Source={StaticResource Loc}}"
                         Subtitle="{Binding [Servers_Tour3Sub], Source={StaticResource Loc}}"
                         CloseButtonContent="{Binding [Common_Done], Source={StaticResource Loc}}"
                         IsOpen="False"/>

        </StackPanel>
    </ScrollViewer>

    <!-- Offline: no imported configs AND backend unreachable -->
    <controls:OfflineNotice x:Name="OfflinePanel" Visibility="Collapsed"
                            BodyKey="Offline_ConfigsBody" ShowImportButton="True"/>
    </Grid>
</Page>
