<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lithiumvpn.Pages.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lithiumvpn"
    xmlns:dev="using:DevWinUI">

    <ScrollViewer Padding="16,15,16,15" VerticalScrollBarVisibility="Auto"
                  FlowDirection="{Binding FlowDirection, Source={StaticResource Loc}}">
        <StackPanel Spacing="10">

            <!-- ── Profile Card ── -->
            <Border x:Name="ProfileCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <PersonPicture x:Name="ProfileAvatar"
                                   Grid.Column="0"
                                   DisplayName="Mrexe"
                                   Width="52" Height="52"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="ProfileName"
                                   Text="Mrexe"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="ProfileEmail"
                                   Text="gogolk1388@gmail.com"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Active Subscriptions ── -->
            <TextBlock Text="{Binding [Account_ActiveSubscriptions], Source={StaticResource Loc}}"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="2,6,0,0"/>

            <!-- Plan Card 1 -->
            <Border x:Name="PlanCard1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16,14">
                <StackPanel Spacing="12">

                    <!-- Plan header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                                CornerRadius="6" Padding="8,3">
                            <TextBlock Text="{Binding [Account_PlanPro], Source={StaticResource Loc}}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>
                        <Border Grid.Column="2"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xEC92;" FontSize="11"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [Account_47DaysLeft], Source={StaticResource Loc}}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Stats -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                            <FontIcon Glyph="&#xECAD;" FontSize="16"
                                      Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="6.75 GB"
                                       FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding [Account_DataLeft], Source={StaticResource Loc}}"
                                       FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                            <FontIcon Glyph="&#xEC92;" FontSize="16"
                                      Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding [Account_47Days], Source={StaticResource Loc}}"
                                       FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding [Account_Expiry], Source={StaticResource Loc}}"
                                       FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                            <FontIcon Glyph="&#xE12B;" FontSize="16"
                                      Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="12"
                                       FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding [Account_Locations], Source={StaticResource Loc}}"
                                       FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Data usage bar -->
                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock Text="{Binding [Account_DataUsage], Source={StaticResource Loc}}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="32%" HorizontalAlignment="Right"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <ProgressBar Value="32" Maximum="100"
                                     Height="5" CornerRadius="3"
                                     Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                                     Background="{ThemeResource ControlAltFillColorQuarternaryBrush}"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Plan Card 2 -->
            <Border x:Name="PlanCard2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16,14">
                <StackPanel Spacing="12">

                    <!-- Plan header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                                CornerRadius="6" Padding="8,3">
                            <TextBlock Text="{Binding [Account_PlanBasic], Source={StaticResource Loc}}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>
                        <Border Grid.Column="2"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xEC92;" FontSize="11"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [Account_180DaysLeft], Source={StaticResource Loc}}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Stats -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                            <FontIcon Glyph="&#xECAD;" FontSize="16"
                                      Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="2.0 GB"
                                       FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding [Account_DataLeft], Source={StaticResource Loc}}"
                                       FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                            <FontIcon Glyph="&#xEC92;" FontSize="16"
                                      Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding [Account_180Days], Source={StaticResource Loc}}"
                                       FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding [Account_Expiry], Source={StaticResource Loc}}"
                                       FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                            <FontIcon Glyph="&#xE12B;" FontSize="16"
                                      Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="5"
                                       FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding [Account_Locations], Source={StaticResource Loc}}"
                                       FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Data usage bar -->
                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock Text="{Binding [Account_DataUsage], Source={StaticResource Loc}}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="78%" HorizontalAlignment="Right"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <ProgressBar Value="78" Maximum="100"
                                     Height="5" CornerRadius="3"
                                     Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                                     Background="{ThemeResource ControlAltFillColorQuarternaryBrush}"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ── Account ── -->
            <TextBlock Text="{Binding [Account_Section], Source={StaticResource Loc}}"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="2,6,0,0"/>

            <!-- Sign Out -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14,12">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xF3B1;" FontSize="15"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding [Account_SignOut], Source={StaticResource Loc}}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Row="0" Grid.Column="2"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Content="{Binding [Account_SignOutBtn], Source={StaticResource Loc}}" Padding="10,5"
                            Click="SignOut_Click"/>

                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                               Text="{Binding [Account_SignOutDesc], Source={StaticResource Loc}}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </Border>

            <!-- Delete Account -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="#40E53935"
                    BorderThickness="1" CornerRadius="12" Padding="14,12"
                    Margin="0,0,0,4">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xE74D;" FontSize="15"
                              Foreground="#FFE53935"
                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding [Account_DeleteAccount], Source={StaticResource Loc}}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#FFE53935"
                               VerticalAlignment="Center"/>
                    <Button Grid.Row="0" Grid.Column="2"
                            Background="#20E53935"
                            BorderBrush="#40E53935"
                            BorderThickness="1" CornerRadius="8"
                            Padding="10,5"
                            Click="DeleteAccount_Click">
                        <TextBlock Text="{Binding [Account_DeleteBtn], Source={StaticResource Loc}}" Foreground="#FFE53935" FontSize="12"/>
                    </Button>

                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                               Text="{Binding [Account_DeleteDesc], Source={StaticResource Loc}}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </Border>

            <TeachingTip x:Name="TourTip1"
                         Target="{x:Bind ProfileCard}"
                         Title="{Binding [Account_Tour1Title], Source={StaticResource Loc}}"
                         Subtitle="{Binding [Account_Tour1Sub], Source={StaticResource Loc}}"
                         ActionButtonContent="{Binding [Common_Next], Source={StaticResource Loc}}"
                         CloseButtonContent="{Binding [Common_SkipTour], Source={StaticResource Loc}}"
                         IsOpen="False"/>

            <TeachingTip x:Name="TourTip2"
                         Target="{x:Bind PlanCard1}"
                         Title="{Binding [Account_Tour2Title], Source={StaticResource Loc}}"
                         Subtitle="{Binding [Account_Tour2Sub], Source={StaticResource Loc}}"
                         ActionButtonContent="{Binding [Common_Next], Source={StaticResource Loc}}"
                         CloseButtonContent="{Binding [Common_SkipTour], Source={StaticResource Loc}}"
                         IsOpen="False"/>

            <TeachingTip x:Name="TourTip3"
                         Title="{Binding [Account_Tour3Title], Source={StaticResource Loc}}"
                         Subtitle="{Binding [Account_Tour3Sub], Source={StaticResource Loc}}"
                         CloseButtonContent="{Binding [Common_Done], Source={StaticResource Loc}}"
                         IsOpen="False"/>

        </StackPanel>
    </ScrollViewer>
</Page>
