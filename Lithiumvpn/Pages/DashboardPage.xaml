<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lithiumvpn.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lithiumvpn"
    xmlns:dev="using:DevWinUI">

    <Page.Resources>
        <Style x:Key="GlassPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <Style x:Key="MainConnectionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="200"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent" UseSystemFocusVisuals="False">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"/>
                                    <VisualState x:Name="Pressed"/>
                                </VisualStateGroup>

                                <VisualStateGroup x:Name="VPNConnectionStates">
                                    <VisualState x:Name="Disconnected">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="PowerIcon"
                                                            Storyboard.TargetProperty="(FontIcon.Foreground).(SolidColorBrush.Color)"
                                                            To="#FF888888" Duration="0:0:0.5"/>
                                            <DoubleAnimation Storyboard.TargetName="OrangeSphere"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.5"/>
                                            <DoubleAnimation Storyboard.TargetName="CyanSphere"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.5"/>
                                            <DoubleAnimation Storyboard.TargetName="ExternalGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.5"/>
                                            <DoubleAnimation Storyboard.TargetName="InnerGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.35" Duration="0:0:0.5"/>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="Connecting">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="PowerIcon"
                                                            Storyboard.TargetProperty="(FontIcon.Foreground).(SolidColorBrush.Color)"
                                                            To="#FFFF9800" Duration="0:0:0.5"/>
                                            <DoubleAnimation Storyboard.TargetName="CyanSphere"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.5"/>
                                            <DoubleAnimation Storyboard.TargetName="OrangeSphere"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.2" To="1" Duration="0:0:1"
                                                             RepeatBehavior="Forever" AutoReverse="True"/>
                                            <DoubleAnimation Storyboard.TargetName="ExternalGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4" Duration="0:0:0.5"/>
                                            <ColorAnimation Storyboard.TargetName="GlowColorStop"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#FF9800" Duration="0:0:0.5"/>
                                            <DoubleAnimation Storyboard.TargetName="InnerGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.5" Duration="0:0:0.5"/>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="Connected">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="PowerIcon"
                                                            Storyboard.TargetProperty="(FontIcon.Foreground).(SolidColorBrush.Color)"
                                                            To="#FF00C853" Duration="0:0:0.5"/>
                                            <DoubleAnimation Storyboard.TargetName="OrangeSphere"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.5"/>
                                            <DoubleAnimation Storyboard.TargetName="CyanSphere"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.5"/>
                                            <DoubleAnimation Storyboard.TargetName="ExternalGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.8" Duration="0:0:0.5"/>
                                            <ColorAnimation Storyboard.TargetName="GlowColorStop"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#00C853" Duration="0:0:0.5"/>
                                            <DoubleAnimation Storyboard.TargetName="InnerGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.7" Duration="0:0:0.5"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Ellipse x:Name="ExternalGlow" Width="260" Height="260" Opacity="0"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                                         RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop x:Name="GlowColorStop" Color="#888" Offset="0.0"/>
                                        <GradientStop Color="#00000000" Offset="0.75"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Ellipse x:Name="BaseSphere" Width="180" Height="180" Opacity="1">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                                        <GradientStop Color="#D0FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#40FFFFFF" Offset="0.35"/>
                                        <GradientStop Color="#18000000" Offset="0.75"/>
                                        <GradientStop Color="#35000000" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Ellipse x:Name="InnerGlow" Width="130" Height="130" Opacity="0.35"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Ellipse x:Name="OrangeSphere" Width="180" Height="180" Opacity="0">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                                        <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#80FF9800" Offset="0.4"/>
                                        <GradientStop Color="#20000000" Offset="0.9"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Ellipse x:Name="CyanSphere" Width="180" Height="180" Opacity="0">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                                        <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#8000C853" Offset="0.4"/>
                                        <GradientStop Color="#20000000" Offset="0.9"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Ellipse Width="180" Height="180" Stroke="#40FFFFFF" StrokeThickness="1.5"/>

                            <FontIcon x:Name="PowerIcon" Glyph="&#xE7E8;" FontSize="48"
                                      Foreground="#FF888888"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20,15,20,15"
          FlowDirection="{Binding FlowDirection, Source={StaticResource Loc}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- هدر: config selection bar -->
        <Border x:Name="ConfigHeaderBorder" Grid.Row="0" Style="{StaticResource GlassPanelStyle}"
        Padding="15,10" BorderThickness="0,0,0,1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ✅ پرچم — از Ellipse با ImageBrush برای پرچم SVG به‌صورت دایره‌ای استفاده می‌کنیم؛ TextBlock اموجی به‌عنوان fallback -->
                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Ellipse x:Name="ConfigFlagEllipse" Width="28" Height="28" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="Transparent" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock x:Name="ConfigFlag" Text="🇩🇪" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>

                <!-- ✅ اطلاعات کانفیگ -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ConfigCountry"
                       Text="Germany (DE)"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       FontWeight="SemiBold" FontSize="14"/>
                    <!-- Config name (shown after selecting a config) -->
                    <TextBlock x:Name="ConfigName"
                       Text="cnokvtb2"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="12"/>
                </StackPanel>

                <!-- ✅ دکمه باز کردن مودال -->
                <Button Grid.Column="2"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10"
                Width="36" Height="36" Padding="0"
                Click="ConfigSelector_Click">
                    <FontIcon Glyph="&#xE70D;" FontSize="12"
                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </Button>
            </Grid>
        </Border>

        <!-- دکمه اتصال -->
        <Grid Grid.Row="1">
            <Button x:Name="MainConnectButton"
                    Style="{StaticResource MainConnectionButtonStyle}"
                    Click="MainConnectButton_Click"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- پیام خطا / وضعیت اتصال -->
            <InfoBar x:Name="ConnectionInfoBar"
                     IsOpen="False"
                     Severity="Error"
                     IsClosable="True"
                     VerticalAlignment="Top"
                     Margin="0,8,0,0"/>
        </Grid>

        <!-- کارت‌های اطلاعاتی پایین -->
        <Grid x:Name="StatsGrid" Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassPanelStyle}" Margin="0,0,5,5">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" Text="{Binding [Dash_GbLeft], Source={StaticResource Loc}}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" Margin="0,0,0,10"/>
                    <Grid HorizontalAlignment="Center">
                        <ProgressRing x:Name="DataProgressRing"
                          IsIndeterminate="False"
                          Value="0"
                          Foreground="#8ca84c"
                          Background="{ThemeResource ControlAltFillColorQuarternaryBrush}"
                          Width="60" Height="60"/>
                        <TextBlock x:Name="DataValue" Text="6.75" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassPanelStyle}" Margin="5,0,5,5">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" Text="{Binding [Dash_Expiry], Source={StaticResource Loc}}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ExpiryValue" Text="47" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="Bold" FontSize="26" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding [Dash_DaysLeft], Source={StaticResource Loc}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource GlassPanelStyle}" Margin="5,0,0,5">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding [Dash_Ping], Source={StaticResource Loc}}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,5,0,0">
                        <TextBlock x:Name="PingValue" Text="24" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="Bold" FontSize="26"/>
                        <TextBlock Text=" ms" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassPanelStyle}" Margin="0,0,5,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding [Dash_Upload], Source={StaticResource Loc}}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   FontSize="13" Margin="0,0,0,5"
                                   HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UploadValue" Text="—"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       FontWeight="Bold" FontSize="22"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="UploadUnit" Text=" MB"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource GlassPanelStyle}" Margin="5,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding [Dash_Download], Source={StaticResource Loc}}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   FontSize="13" Margin="0,0,0,5"
                                   HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DownloadValue" Text="—"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       FontWeight="Bold" FontSize="22"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DownloadUnit" Text=" MB"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <TeachingTip x:Name="TourTip1"
                     Target="{x:Bind ConfigHeaderBorder}"
                     Title="{Binding [Dash_Tour1Title], Source={StaticResource Loc}}"
                     Subtitle="{Binding [Dash_Tour1Sub], Source={StaticResource Loc}}"
                     ActionButtonContent="{Binding [Common_Next], Source={StaticResource Loc}}"
                     CloseButtonContent="{Binding [Common_SkipTour], Source={StaticResource Loc}}"
                     PlacementMargin="8"
                     IsOpen="False"/>

        <TeachingTip x:Name="TourTip2"
                     Target="{x:Bind MainConnectButton}"
                     Title="{Binding [Dash_Tour2Title], Source={StaticResource Loc}}"
                     Subtitle="{Binding [Dash_Tour2Sub], Source={StaticResource Loc}}"
                     ActionButtonContent="{Binding [Common_Next], Source={StaticResource Loc}}"
                     CloseButtonContent="{Binding [Common_SkipTour], Source={StaticResource Loc}}"
                     IsOpen="False"/>

        <TeachingTip x:Name="TourTip3"
                     Target="{x:Bind StatsGrid}"
                     Title="{Binding [Dash_Tour3Title], Source={StaticResource Loc}}"
                     Subtitle="{Binding [Dash_Tour3Sub], Source={StaticResource Loc}}"
                     CloseButtonContent="{Binding [Common_Done], Source={StaticResource Loc}}"
                     IsOpen="False"/>
    </Grid>
</Page>
