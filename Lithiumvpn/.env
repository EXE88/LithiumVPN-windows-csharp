# ─────────────────────────────────────────────────────────────
#  LithiumVPN — Backend configuration
# ─────────────────────────────────────────────────────────────
#  Set the base URL of your XUI-Accounter API backend here.
#  No trailing slash is required (it is trimmed automatically).
#
#  Examples:
#     API_BASE_URL=http://127.0.0.1:8000
#     API_BASE_URL=https://api.mydomain.com
#
API_BASE_URL=http://127.0.0.1:8000

#  Network timeout for API requests, in seconds (optional).
API_TIMEOUT_SECONDS=30

#  How often (seconds) the app refreshes data from the backend (status,
#  events, tickets) and reports this client online. Minimum 5.
HEARTBEAT_SECONDS=20

#  URL used by the per-config ping test (a temporary Xray core is started
#  and this URL is requested through it; expects a 204/2xx response).
PING_URL=https://www.google.com/generate_204

#  URL used to verify the tunnel passes traffic right after connecting,
#  and for the live latency shown on the dashboard while connected.
TUNNEL_CHECK_URL=https://www.google.com/generate_204
